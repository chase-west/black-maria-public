# Copy to deploy/.env and fill in.
# The portal's hostname. Caddy serves it on TCP 443.
DOMAIN=blackmaria.example.com
# The wire's hostname: a plain A record to this box, never behind a proxying CDN. Defaults to DOMAIN.
# WIRE_HOST=wire.blackmaria.example.com
ACME_EMAIL=ops@example.com
# At least 8 characters; reviewers type it into /review.
ADMIN_TOKEN=change-me-to-a-long-random-string
# The cohort window (ISO 8601, UTC).
WINDOW_OPENS=2026-11-02T09:00:00Z
WINDOW_CLOSES=2026-11-09T09:00:00Z
MAX_CONCURRENT_MATCHES=40
# Where candidates get the code (SPEC 6). The image serves the public repository and the two packages at /download,
# and the portal's install line uses them. Set PUBLIC_REPO_URL to link a public git repository instead of the tarball,
# PACKAGES_ON_NPM=1 prints the npm install commands; both packages are published. Set to 0 to serve tarballs from the portal instead.
# PUBLIC_REPO_URL=https://github.com/you/black-maria-public
PACKAGES_ON_NPM=1
# Leave unset in production; DEV_TOKEN seeds a test token.
# DEV_TOKEN=
APP_CPUS=2
# Host ports, for a test deploy next to something else that holds them. Leave unset in production.
# HTTPS_PORT=8443
# HTTPS_PORT_SUFFIX=:8443
# WIRE_PORT_HOST=17777
# WIRE_FALLBACK_HOST=18443
# Wire sessions from one source address at once (default 16). Candidates behind one campus NAT share an address;
# raise it for such a cohort, and for a load test run from one machine.
# WIRE_SESSIONS_PER_IP=16
