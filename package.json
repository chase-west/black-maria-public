{
  "name": "blackmaria-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "ci": "sh scripts/ci.sh",
    "layout": "tsx scripts/layout-check.ts",
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm --filter @blackmaria/web run dev",
    "assets:placeholders": "pnpm --filter @blackmaria/assetgen run generate",
    "test:ts": "vitest run",
    "dev:server": "pnpm --filter @blackmaria/server run dev",
    "sim": "pnpm --silent --filter @black-maria/sim run sim",
    "client": "pnpm --silent --filter @blackmaria/client run blackmaria",
    "pack:public": "node scripts/pack-public.mjs",
    "e2e:publish": "sh scripts/e2e-publish.sh",
    "export:public": "node scripts/export-public.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
